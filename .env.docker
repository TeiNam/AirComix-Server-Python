# Comix Server Docker Environment Configuration
# Copy this file to .env and customize for your setup

# =============================================================================
# BASIC CONFIGURATION
# =============================================================================

# Path to your manga/comic collection on the host system
# This directory will be mounted read-only into the container
MANGA_DIRECTORY=/path/to/your/manga/collection

# Port to expose the server on (default: 31257)
COMIX_SERVER_PORT=31257

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Enable debug mode (true/false)
# WARNING: Only enable for development/troubleshooting
DEBUG_MODE=false

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# =============================================================================
# AUTHENTICATION (Optional, .htaccess style - password only)
# =============================================================================

# Enable HTTP Basic authentication (true/false)
# COMIX_ENABLE_AUTH=true

# Password used when authentication is enabled (minimum 6 characters, required)
# COMIX_AUTH_PASSWORD=change_me_please

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================

# Custom configuration directory (optional)
# CONFIG_DIRECTORY=/path/to/config

# =============================================================================
# ADVANCED CONFIGURATION (Optional)
# =============================================================================

# List-type settings MUST be JSON arrays. A comma-separated string fails to parse
# and the server will not start.
# Leave empty to use defaults.
# COMIX_HIDDEN_FILES=[".DS_Store", "Thumbs.db", "@eaDir"]
# COMIX_HIDDEN_PATTERNS=["__MACOSX"]

# Custom supported file extensions (JSON arrays)
# IMAGE_EXTENSIONS=["jpg", "jpeg", "png", "gif", "bmp", "tif", "tiff"]
# ARCHIVE_EXTENSIONS=["zip", "cbz", "rar", "cbr"]

# Streaming limits (bytes)
# MAX_FILE_SIZE=104857600
# CHUNK_SIZE=8192

# =============================================================================
# DOCKER COMPOSE OVERRIDES
# =============================================================================

# Override Docker Compose service name (optional)
# COMPOSE_PROJECT_NAME=comix-server

# Override container name (optional)
# CONTAINER_NAME=my-comix-server